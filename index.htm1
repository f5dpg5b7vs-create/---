<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>탐라배 곱꽹대전</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Noto Sans KR",
        sans-serif;
      background: #07111f;
      color: white;
      overflow-x: hidden;
    }

    /* =====================
       첫 화면
    ===================== */

    .hero {
      min-height: 100vh;
      position: relative;
      overflow: hidden;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      background:
        linear-gradient(
          to bottom,
          #07101e 0%,
          #0c1d32 55%,
          #19334b 100%
        );
    }

    /* 달 */

    .moon {
      position: absolute;
      top: 10%;
      right: 13%;

      width: 90px;
      height: 90px;

      background: #fff9df;
      border-radius: 50%;

      box-shadow:
        0 0 30px rgba(255, 249, 223, 0.5),
        0 0 80px rgba(255, 249, 223, 0.15);
    }

    /* 제목 */

    .title {
      position: relative;
      z-index: 5;

      text-align: center;
      margin-bottom: 80px;

      text-shadow:
        0 2px 10px rgba(0,0,0,.5);
    }

    .title h1 {
      margin: 0;

      font-family: serif;
      font-size: clamp(38px, 10vw, 76px);
      letter-spacing: -4px;
    }

    .title p {
      margin-top: 15px;
      font-size: 14px;
      letter-spacing: 5px;
      opacity: .7;
    }

    /* =====================
       눈
    ===================== */

    .snow {
      position: absolute;
      inset: 0;

      pointer-events: none;
      z-index: 3;
    }

    .snow span {
      position: absolute;

      width: 5px;
      height: 5px;

      background: white;
      border-radius: 50%;

      opacity: .8;

      animation:
        fall linear infinite;
    }

    @keyframes fall {
      from {
        transform: translateY(-20px) translateX(0);
      }

      to {
        transform: translateY(110vh) translateX(40px);
      }
    }

    /* =====================
       겨울길
    ===================== */

    .road {
      position: absolute;
      bottom: 0;
      left: 50%;

      transform: translateX(-50%);

      width: 120%;
      height: 38%;

      background:
        linear-gradient(
          to bottom,
          #dce8ee,
          #a9bdc9
        );

      clip-path: polygon(
        40% 0,
        60% 0,
        100% 100%,
        0 100%
      );

      z-index: 1;
    }

    .road::after {
      content: "";

      position: absolute;
      left: 50%;
      top: 0;

      width: 4px;
      height: 100%;

      transform: translateX(-50%);

      background: rgba(255,255,255,.45);
      opacity: .5;
    }

    /* =====================
       눈사람 영역
    ===================== */

    .snowmen {
      position: absolute;

      bottom: 8%;
      left: 50%;

      transform: translateX(-50%);

      width: min(900px, 95%);

      display: flex;
      justify-content: space-around;
      align-items: flex-end;

      z-index: 10;
    }

    .snowman-button {
      border: 0;
      background: transparent;
      color: white;

      cursor: pointer;

      display: flex;
      flex-direction: column;
      align-items: center;

      transition:
        transform .3s ease;
    }

    .snowman-button:hover {
      transform: translateY(-12px) scale(1.05);
    }

    .snowman-button:active {
      transform: scale(.95);
    }

    /* 눈사람 */

    .snowman {
      position: relative;

      width: 115px;
      height: 175px;
    }

    .body {
      position: absolute;
      bottom: 0;
      left: 50%;

      transform: translateX(-50%);

      width: 100px;
      height: 100px;

      background: #f7fbff;
      border-radius: 50%;

      box-shadow:
        inset -12px -10px 20px rgba(100,130,150,.18);
    }

    .body::before {
      content: "";

      position: absolute;

      width: 75px;
      height: 75px;

      left: 50%;
      top: -52px;

      transform: translateX(-50%);

      background: #f7fbff;
      border-radius: 50%;

      box-shadow:
        inset -8px -8px 15px rgba(100,130,150,.15);
    }

    /* 눈 */

    .body::after {
      content: "●  ●";

      position: absolute;

      left: 50%;
      top: -31px;

      transform: translateX(-50%);

      color: #152334;
      font-size: 13px;

      letter-spacing: 7px;
      white-space: nowrap;
    }

    /* 코 */

    .nose {
      position: absolute;

      left: 50%;
      top: 48px;

      transform: translateX(5px);

      width: 0;
      height: 0;

      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
      border-left: 20px solid #ed8d3c;

      z-index: 3;
    }

    /* 모자 */

    .hat {
      position: absolute;

      top: -73px;
      left: 50%;

      transform: translateX(-50%);

      width: 60px;
      height: 28px;

      background: #17273a;
      border-radius: 5px 5px 2px 2px;

      z-index: 4;
    }

    .hat::after {
      content: "";

      position: absolute;

      left: -8px;
      bottom: -5px;

      width: 76px;
      height: 8px;

      background: #17273a;
      border-radius: 5px;
    }

    /* 단추 */

    .buttons {
      position: absolute;

      left: 50%;
      top: 33px;

      transform: translateX(-50%);

      display: flex;
      flex-direction: column;
      gap: 9px;

      color: #26384c;
    }

    /* 팔 */

    .arm {
      position: absolute;

      width: 55px;
      height: 5px;

      background: #624b3a;

      top: 50px;

      border-radius: 10px;
    }

    .arm.left {
      left: -32px;
      transform: rotate(-20deg);
    }

    .arm.right {
      right: -32px;
      transform: rotate(20deg);
    }

    /* 설명 */

    .snowman-label {
      margin-top: 18px;

      padding: 8px 15px;

      border-radius: 30px;

      background: rgba(0,0,0,.3);
      backdrop-filter: blur(5px);

      font-size: 14px;
      letter-spacing: 1px;
    }

    /* =====================
       페이지
    ===================== */

    .page {
      min-height: 100vh;

      padding:
        90px 20px
        100px;

      background: #f4f6f8;
      color: #182535;
    }

    .page-inner {
      width: min(900px, 100%);
      margin: auto;
    }

    .page h2 {
      font-family: serif;

      font-size: clamp(34px, 8vw, 52px);

      margin-bottom: 10px;
    }

    .page-description {
      color: #6d7885;
      margin-bottom: 50px;
    }

    /* 글 */

    .story-card {
      padding: 30px;
      margin-bottom: 20px;

      background: white;

      border-radius: 15px;

      box-shadow:
        0 10px 30px rgba(0,0,0,.07);

      cursor: pointer;

      transition: transform .2s;
    }

    .story-card:hover {
      transform: translateY(-4px);
    }

    .story-card h3 {
      margin-top: 0;

      font-family: serif;
      font-size: 24px;
    }

    .story-card p {
      color: #687481;
      line-height: 1.8;
    }

    /* 사진 */

    .photo-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;
    }

    .photo {
      aspect-ratio: 1;

      border-radius: 15px;

      background:
        linear-gradient(
          135deg,
          #d9e5ec,
          #8fa9ba
        );

      display: flex;
      align-items: center;
      justify-content: center;

      color: white;

      font-size: 14px;

      overflow: hidden;
    }

    /* 영상 */

    .video-card {
      background: #101c29;

      border-radius: 15px;

      padding: 20px;

      margin-bottom: 20px;
    }

    .video-placeholder {
      aspect-ratio: 16 / 9;

      background:
        linear-gradient(
          135deg,
          #20374d,
          #07111f
        );

      border-radius: 10px;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 45px;
    }

    .video-card h3 {
      margin-bottom: 5px;
    }

    .video-card p {
      opacity: .6;
    }

    /* 돌아가기 */

    .back {
      display: inline-block;

      margin-bottom: 30px;

      color: #566575;
      text-decoration: none;

      font-size: 14px;
    }

    .back:hover {
      text-decoration: underline;
    }

    /* =====================
       모바일
    ===================== */

    @media (max-width: 600px) {

      .moon {
        width: 60px;
        height: 60px;

        top: 8%;
        right: 10%;
      }

      .title {
        margin-bottom: 110px;
      }

      .title h1 {
        letter-spacing: -2px;
      }

      .snowmen {
        bottom: 7%;
      }

      .snowman {
        transform: scale(.65);
        margin: -15px;
      }

      .snowman-label {
        margin-top: -10px;

        font-size: 11px;
        padding: 6px 9px;
      }

      .photo-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       첫 화면
  ========================== -->

  <section class="hero">

    <div class="moon"></div>

    <div class="snow" id="snow"></div>

    <div class="title">
      <h1>탐라배 곱꽹대전</h1>
      <p>WINTER LITERARY WEBZINE</p>
    </div>

    <div class="road"></div>

    <div class="snowmen">

      <!-- 첫 번째 -->
      <button
        class="snowman-button"
        onclick="location.hash='stories'"
        aria-label="소설 페이지로 이동"
      >
        <div class="snowman">

          <div class="hat"></div>

          <div class="body">
            <div class="nose"></div>

            <div class="buttons">
              ●
              ●
              ●
            </div>

            <div class="arm left"></div>
            <div class="arm right"></div>
          </div>

        </div>

        <div class="snowman-label">
          글
        </div>
      </button>


      <!-- 두 번째 -->
      <button
        class="snowman-button"
        onclick="location.hash='photos'"
        aria-label="사진 페이지로 이동"
      >
        <div class="snowman">

          <div class="hat"></div>

          <div class="body">
            <div class="nose"></div>

            <div class="buttons">
              ●
              ●
              ●
            </div>

            <div class="arm left"></div>
            <div class="arm right"></div>
          </div>

        </div>

        <div class="snowman-label">
          사진
        </div>
      </button>


      <!-- 세 번째 -->
      <button
        class="snowman-button"
        onclick="location.hash='videos'"
        aria-label="영상 페이지로 이동"
      >
        <div class="snowman">

          <div class="hat"></div>

          <div class="body">
            <div class="nose"></div>

            <div class="buttons">
              ●
              ●
              ●
            </div>

            <div class="arm left"></div>
            <div class="arm right"></div>
          </div>

        </div>

        <div class="snowman-label">
          영상
        </div>
      </button>

    </div>

  </section>


  <!-- =========================
       글 페이지
  ========================== -->

  <section class="page" id="stories">

    <div class="page-inner">

      <a class="back" href="#">
        ← 겨울길로 돌아가기
      </a>

      <h2>글</h2>

      <p class="page-description">
        탐라배 곱꽹대전에 모인 이야기들
      </p>


      <article class="story-card">
        <h3>첫 번째 이야기</h3>

        <p>
          아직 제목을 정하지 않은 소설입니다.
          이곳에 작품의 짧은 소개를 적을 수 있어요.
        </p>
      </article>


      <article class="story-card">
        <h3>두 번째 이야기</h3>

        <p>
          겨울밤, 눈이 내리는 길에서 시작되는 이야기.
        </p>
      </article>


      <article class="story-card">
        <h3>세 번째 이야기</h3>

        <p>
          새로운 작품을 이곳에 추가해주세요.
        </p>
      </article>

    </div>

  </section>


  <!-- =========================
       사진 페이지
  ========================== -->

  <section class="page" id="photos">

    <div class="page-inner">

      <a class="back" href="#">
        ← 겨울길로 돌아가기
      </a>

      <h2>사진</h2>

      <p class="page-description">
        탐라배 곱꽹대전의 이미지 아카이브
      </p>


      <div class="photo-grid">

        <div class="photo">
          PHOTO 01
        </div>

        <div class="photo">
          PHOTO 02
        </div>

        <div class="photo">
          PHOTO 03
        </div>

        <div class="photo">
          PHOTO 04
        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       영상 페이지
  ========================== -->

  <section class="page" id="videos">

    <div class="page-inner">

      <a class="back" href="#">
        ← 겨울길로 돌아가기
      </a>

      <h2>영상</h2>

      <p class="page-description">
        탐라배 곱꽹대전의 영상 기록
      </p>


      <div class="video-card">

        <div class="video-placeholder">
          ▶
        </div>

        <h3>첫 번째 영상</h3>

        <p>
          영상 설명을 여기에 적어주세요.
        </p>

      </div>


      <div class="video-card">

        <div class="video-placeholder">
          ▶
        </div>

        <h3>두 번째 영상</h3>

        <p>
          영상 설명을 여기에 적어주세요.
        </p>

      </div>

    </div>

  </section>


  <script>

    /* =========================
       눈 생성
    ========================== */

    const snow = document.getElementById("snow");

    for (let i = 0; i < 90; i++) {

      const flake = document.createElement("span");

      flake.style.left =
        Math.random() * 100 + "%";

      flake.style.top =
        Math.random() * -100 + "px";

      const size =
        Math.random() * 5 + 2;

      flake.style.width =
        size + "px";

      flake.style.height =
        size + "px";

      flake.style.opacity =
        Math.random() * .7 + .3;

      flake.style.animationDuration =
        Math.random() * 8 + 5 + "s";

      flake.style.animationDelay =
        Math.random() * 8 + "s";

      snow.appendChild(flake);
    }

  </script>

</body>
</html>
